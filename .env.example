# Copy to gateway/.env and fill in. Never commit the real file.

# AssemblyAI API key, used for the Voice Agent sessions and the LLM Gateway.
# Get one at https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# Shared secret the phone (or the owner console) must send to register as the
# owner. Without it, callers still work but nobody can take their calls.
# Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GATEWAY_AUTH_SECRET=

# Optional
PORT=3000
# How long an unanswered call waits before the secretary takes a message (ms)
TAKE_MESSAGE_AFTER_MS=90000
# The owner's time zone, used to turn "tomorrow" into a real due date
KABEER_TIMEZONE=Asia/Karachi
# Model for post-call summaries through the AssemblyAI LLM Gateway
SUMMARY_MODEL=qwen3.5-4b-32k-fast
